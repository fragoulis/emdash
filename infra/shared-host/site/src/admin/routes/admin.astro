---
import adminStylesUrl from "@emdash-cms/admin/styles.css?url";
import { getLocaleDir, loadMessages, resolveLocale } from "@emdash-cms/admin/locales";
import { translateCentralAdminLabels } from "@emdash-cms/admin/locales/server";
import { AdminAccess } from "../AdminAccess.js";

export const prerender = false;
const noAccess = Astro.url.pathname === "/_emdash/admin/no-access";
const signInUrl = import.meta.env.PUBLIC_CLERK_SIGN_IN_URL;
if (!signInUrl || new URL(signInUrl).protocol !== "https:") {
	throw new Error("Set PUBLIC_CLERK_SIGN_IN_URL to the hosted Clerk sign-in URL");
}
const hostedSignIn = new URL(signInUrl);
if (!process.env.PROOF_ADMIN_ORIGIN) throw new Error("Set PROOF_ADMIN_ORIGIN");
hostedSignIn.searchParams.set(
	"redirect_url",
	`${process.env.PROOF_ADMIN_ORIGIN}/_emdash/admin/login`,
);
const locale = resolveLocale(Astro.request);
const messages = await loadMessages(locale);
const labels = translateCentralAdminLabels(messages);
const title = noAccess ? labels.noSiteAccess : labels.signIn;
const documentTitle = noAccess ? labels.noSiteAccessTitle : labels.signInTitle;
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<!doctype html>
<html lang={locale} dir={getLocaleDir(locale)} data-theme="classic">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{documentTitle}</title>
		<link rel="stylesheet" href={adminStylesUrl} />
	</head>
	<body>
		<AdminAccess
			client:load
			noAccess={noAccess}
			signInUrl={hostedSignIn.toString()}
			title={title}
			description={noAccess ? labels.noSiteDescription : labels.signInDescription}
			continueLabel={labels.continueToClerk}
			signOutLabel={labels.signOut}
			signOutError={labels.signOutError}
		/>
	</body>
</html>
